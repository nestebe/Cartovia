<Window x:Class="Cartovia.Samples.WinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:carto="using:Cartovia.WinUI"
        Title="Cartovia — WinUI 3 showcase">

    <Grid Background="#0A0F1C" RequestedTheme="Dark">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer Padding="14,18,14,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="6,0,0,0">
                        <Border Width="36" Height="36" CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#818CF8" Offset="0" />
                                    <GradientStop Color="#22D3EE" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <FontIcon Glyph="&#xE707;" FontSize="18" Foreground="White" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Cartovia" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Vector maps for .NET desktop" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Margin="0,16,0,0" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="10,7"
                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="EngineDot" Width="8" Height="8" Fill="#F59E0B" VerticalAlignment="Center" />
                            <TextBlock x:Name="EngineText" Text="Starting…" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="MAP STYLE" Style="{StaticResource SectionHeader}" />
                    <StackPanel x:Name="StylePanel" Orientation="Horizontal" />

                    <TextBlock Text="FLY TO" Style="{StaticResource SectionHeader}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Paris" Style="{StaticResource Pill}" Click="OnFlyParis" />
                        <Button Content="New York" Style="{StaticResource Pill}" Click="OnFlyNewYork" />
                        <Button Content="Mont Blanc" Style="{StaticResource Pill}" Click="OnFlyMontBlanc" />
                    </StackPanel>

                    <TextBlock Text="LAYERS" Style="{StaticResource SectionHeader}" />
                    <Border Background="{StaticResource CardBrush}" CornerRadius="12" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" Padding="12,4">
                        <StackPanel>
                            <Grid Height="40">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE80F;" FontSize="15" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="3D buildings" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="BuildingsToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="OnToggleBuildings" />
                            </Grid>
                            <Grid Height="40">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE716;" FontSize="15" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="Cities" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="CitiesToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="OnToggleCities" />
                            </Grid>
                            <Grid Height="40">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE71D;" FontSize="15" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="Clustered points" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="ClustersToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="OnToggleClusters" />
                            </Grid>
                            <Grid Height="40">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE909;" FontSize="15" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="3D terrain" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="TerrainToggle" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="OnToggleTerrain" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="TOOLS" Style="{StaticResource SectionHeader}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Draggable marker" Style="{StaticResource Pill}" Click="OnAddMarker" />
                        <Button Content="Screenshot" Style="{StaticResource Pill}" Click="OnScreenshot" />
                    </StackPanel>

                    <TextBlock Margin="6,16,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="MapLibre GL JS or Mapbox GL JS · WinUI 3 WebView2 · Windows App SDK" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Map -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <carto:MapView x:Name="MapView" Longitude="2.3470" Latitude="48.8540" Zoom="15.6" Pitch="60" Bearing="-24" />
            <Border Grid.Row="1" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="16,7">
                <TextBlock x:Name="StatusText" FontSize="12" Text="—" />
            </Border>
        </Grid>
    </Grid>
</Window>
