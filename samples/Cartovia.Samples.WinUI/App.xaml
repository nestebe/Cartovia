<Application x:Class="Cartovia.Samples.WinUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="SidebarBrush" Color="#0F1626" />
            <SolidColorBrush x:Key="CardBrush" Color="#151E31" />
            <SolidColorBrush x:Key="StrokeBrush" Color="#22304A" />
            <SolidColorBrush x:Key="MutedBrush" Color="#8391AB" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#262B63" />
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="Margin" Value="6,14,0,6" />
            </Style>
            <Style x:Key="Pill" TargetType="Button">
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="Margin" Value="0,0,6,6" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
