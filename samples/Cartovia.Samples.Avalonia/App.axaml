<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Cartovia.Samples.Avalonia.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#0A0F1C" />
        <SolidColorBrush x:Key="SidebarBrush" Color="#0F1626" />
        <SolidColorBrush x:Key="CardBrush" Color="#151E31" />
        <SolidColorBrush x:Key="HoverBrush" Color="#1D2840" />
        <SolidColorBrush x:Key="PressedBrush" Color="#263352" />
        <SolidColorBrush x:Key="StrokeBrush" Color="#22304A" />
        <SolidColorBrush x:Key="TextBrush" Color="#E6EAF2" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8391AB" />
        <SolidColorBrush x:Key="AccentBrush" Color="#6366F1" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#262B63" />
        <LinearGradientBrush x:Key="LogoBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#818CF8" Offset="0" />
            <GradientStop Color="#22D3EE" Offset="1" />
        </LinearGradientBrush>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="TextBlock.icon">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="6,14,0,6" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <!-- Pill buttons -->
        <Style Selector="Button.pill">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="10,5">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.pill:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{StaticResource HoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Button.pill:pressed /template/ Border#Bd">
            <Setter Property="Background" Value="{StaticResource PressedBrush}" />
        </Style>

        <!-- Action rows -->
        <Style Selector="Button.action">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,8">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.action:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        </Style>

        <!-- Chips -->
        <Style Selector="RadioButton.chip">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bd" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource StrokeBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="12,5">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.chip:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{StaticResource HoverBrush}" />
        </Style>
        <Style Selector="RadioButton.chip:checked /template/ Border#Bd">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <!-- Layer rows: label + switch -->
        <Style Selector="ToggleSwitch.row">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,-4,-6,-4" />
        </Style>
    </Application.Styles>
</Application>
