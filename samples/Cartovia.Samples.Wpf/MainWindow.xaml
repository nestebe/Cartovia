<Window x:Class="Cartovia.Samples.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:carto="clr-namespace:Cartovia.Wpf;assembly=Cartovia.Wpf"
        Title="Cartovia — WPF showcase" Height="940" Width="1480" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar ===================== -->
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Margin="20,22,20,6">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource LogoBrush}">
                            <TextBlock Text="&#xE707;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Cartovia" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Vector maps for .NET desktop" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Border Margin="0,16,0,0" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="10,7"
                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="EngineDot" Width="8" Height="8" Fill="#F59E0B" VerticalAlignment="Center" />
                            <TextBlock x:Name="EngineText" Text="Starting…" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ScrollViewer x:Name="Sidebar" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,0,14,10">
                    <StackPanel>
                        <TextBlock Text="MAP STYLE" Style="{StaticResource SectionHeader}" />
                        <WrapPanel x:Name="StylePanel" Margin="2,0,0,0" />

                        <TextBlock Text="FLY TO" Style="{StaticResource SectionHeader}" />
                        <WrapPanel Margin="2,0,0,0">
                            <Button Content="Paris" Tag="&#xE709;" Style="{StaticResource PillButton}" Click="OnFlyParis" />
                            <Button Content="New York" Tag="&#xE709;" Style="{StaticResource PillButton}" Click="OnFlyNewYork" />
                            <Button Content="Mont Blanc" Tag="&#xE709;" Style="{StaticResource PillButton}" Click="OnFlyMontBlanc" />
                            <Button Content="Tokyo" Tag="&#xE709;" Style="{StaticResource PillButton}" Click="OnFlyTokyo" />
                            <Button Content="Saint-Émilion" Tag="&#xE709;" Style="{StaticResource PillButton}" Click="OnFlySaintEmilion" />
                            <Button Content="Reset view" Tag="&#xE7AD;" Style="{StaticResource PillButton}" Click="OnResetNorth" />
                        </WrapPanel>

                        <TextBlock Text="LAYERS" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ToggleButton x:Name="CitiesToggle" Content="Cities" Tag="&#xE716;" Style="{StaticResource LayerToggle}" Click="OnToggleCities" />
                                <ToggleButton x:Name="ClustersToggle" Content="Clustered points" Tag="&#xE71D;" Style="{StaticResource LayerToggle}" Click="OnToggleClusters" />
                                <ToggleButton x:Name="HeatmapToggle" Content="Heatmap" Tag="&#xE9D2;" Style="{StaticResource LayerToggle}" Click="OnToggleHeatmap" />
                                <ToggleButton x:Name="BuildingsToggle" Content="3D buildings" Tag="&#xE80F;" Style="{StaticResource LayerToggle}" Click="OnToggleBuildings" />
                                <ToggleButton x:Name="TerrainToggle" Content="3D terrain" Tag="&#xE909;" Style="{StaticResource LayerToggle}" Click="OnToggleTerrain" />
                                <ToggleButton x:Name="GlobeToggle" Content="Globe projection" Tag="&#xE774;" Style="{StaticResource LayerToggle}" Click="OnToggleGlobe" />
                                <ToggleButton x:Name="CadastreToggle" Content="Cadastral parcels (France)" Tag="&#xE80A;" Style="{StaticResource LayerToggle}" Click="OnToggleCadastre" />
                            </StackPanel>
                        </Border>

                        <!-- Parcel details, filled from the click event of the cadastre layer -->
                        <StackPanel x:Name="ParcelPanel" Visibility="Collapsed">
                            <TextBlock Text="CADASTRAL PARCEL" Style="{StaticResource SectionHeader}" />
                            <Border Style="{StaticResource Card}" Padding="14,12">
                                <StackPanel>
                                    <TextBlock x:Name="ParcelHint" Text="Hover a parcel, click to select it." FontSize="12"
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                    <Grid x:Name="ParcelDetails" Visibility="Collapsed" TextElement.FontSize="12.5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Commune" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                                        <TextBlock x:Name="ParcelCommune" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
                                        <TextBlock Grid.Row="1" Text="Section" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                                        <TextBlock x:Name="ParcelSection" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" />
                                        <TextBlock Grid.Row="2" Text="Number" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                                        <TextBlock x:Name="ParcelNumber" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" />
                                        <TextBlock Grid.Row="3" Text="Area" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                                        <TextBlock x:Name="ParcelArea" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" />
                                        <TextBlock Grid.Row="4" Text="Parcel id" Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock x:Name="ParcelId" Grid.Row="4" Grid.Column="1" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="TOOLS" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <ToggleButton x:Name="DrawToggle" Content="Draw &amp; edit shapes" Tag="&#xE70F;" Style="{StaticResource LayerToggle}" Click="OnToggleDraw" />
                                <ToggleButton x:Name="SearchToggle" Content="Place search" Tag="&#xE721;" Style="{StaticResource LayerToggle}" Click="OnToggleSearch" />
                                <Button Content="Drop a draggable marker" Tag="&#xE718;" Style="{StaticResource ActionButton}" Click="OnAddMarker" />
                                <Button Content="2 km buffer (Turf.js)" Tag="&#xE8EF;" Style="{StaticResource ActionButton}" Click="OnTurf" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="EXPORT" Style="{StaticResource SectionHeader}" />
                        <WrapPanel Margin="2,0,0,0">
                            <Button Content="Screenshot" Tag="&#xE722;" Style="{StaticResource PillButton}" Click="OnScreenshot" />
                            <Button Content="PDF" Tag="&#xE749;" Style="{StaticResource PillButton}" Click="OnPdf" />
                            <Button Content="Events" Tag="&#xE9D9;" Style="{StaticResource PillButton}" Click="OnShowLog" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="2" Margin="20,8,20,14" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Text="MapLibre GL JS or Mapbox GL JS · WebView2 · .NET 6 / 8 / 10" />
            </Grid>
        </Border>

        <!-- ===================== Map area ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <carto:MapView x:Name="MapView" Center="2.3470, 48.8540" Zoom="15.6" Pitch="60" Bearing="-24" />

            <!-- Event log -->
            <Border x:Name="LogPanel" Grid.Row="1" Height="150" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Visibility="Collapsed">
                <ListBox x:Name="EventLog" Background="Transparent" BorderThickness="0" Padding="10,6"
                         FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="#B9C3D6"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0,1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="16,7">
                <Grid>
                    <StackPanel Orientation="Horizontal" TextElement.FontSize="12">
                        <TextBlock Text="&#xE81D;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,18,0" Text="{Binding Center, ElementName=MapView, Mode=OneWay}" />
                        <TextBlock Text="Zoom" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Margin="6,0,18,0" Text="{Binding Zoom, ElementName=MapView, Mode=OneWay, StringFormat=0.00}" />
                        <TextBlock Text="Bearing" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Margin="6,0,18,0" Text="{Binding Bearing, ElementName=MapView, Mode=OneWay, StringFormat={}{0:0}°}" />
                        <TextBlock Text="Pitch" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Margin="6,0,18,0" Text="{Binding Pitch, ElementName=MapView, Mode=OneWay, StringFormat={}{0:0}°}" />
                        <TextBlock Text="Pointer" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="PointerText" Margin="6,0,0,0" Text="—" />
                    </StackPanel>
                    <ToggleButton x:Name="LogToggle" HorizontalAlignment="Right" Cursor="Hand" Click="OnToggleLog">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Events" Margin="6,0,6,0" FontSize="12" VerticalAlignment="Center" />
                                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="6,0">
                                            <TextBlock Text="{Binding Items.Count, ElementName=EventLog}" FontSize="11" Foreground="#C7D2FE" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
