<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(MapboxNetWindowsTargets)</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Mapbox.Net.WinForms</AssemblyName>
    <RootNamespace>Mapbox.Net.WinForms</RootNamespace>
    <PackageId>Mapbox.Net.WinForms</PackageId>
    <Description>Windows Forms map control for Mapbox GL JS and MapLibre GL JS (WebView2): every layer type and style property, expressions, markers, popups, controls, plugins (draw, geocoder, directions, turf) and events.</Description>
    <PackageTags>$(PackageTags);winforms;windows-forms</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <!-- Removes the WebView2 WPF reference (warning MSB3277) in consumer Windows Forms apps. -->
  <ItemGroup>
    <None Include="..\..\build\Mapbox.Net.RemoveWebView2Wpf.targets" Pack="true" PackagePath="buildTransitive\Mapbox.Net.WinForms.targets" Visible="false" />
    <None Include="..\..\build\Mapbox.Net.RemoveWebView2Wpf.targets" Pack="true" PackagePath="build\Mapbox.Net.WinForms.targets" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mapbox.Net.WebView2\Mapbox.Net.WebView2.csproj" />
  </ItemGroup>

</Project>
