<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(MapboxNetLibraryTargets)</TargetFrameworks>
    <AssemblyName>Mapbox.Net.Core</AssemblyName>
    <RootNamespace>Mapbox.Net</RootNamespace>
    <PackageId>Mapbox.Net.Core</PackageId>
    <Description>UI-agnostic core of Mapbox.Net: strongly-typed Mapbox GL JS / MapLibre GL JS API (camera, sources, every style layer and property, expressions, markers, popups, controls, plugins, events) driven through a JSON bridge. Use Mapbox.Net.Wpf or Mapbox.Net.WinForms for a ready-to-use control.</Description>
  </PropertyGroup>

  <!-- .NET 6 ships System.Text.Json 6; use the 8.x package for a consistent API surface. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mapbox.Net.WebView2" />
    <InternalsVisibleTo Include="Mapbox.Net.Wpf" />
    <InternalsVisibleTo Include="Mapbox.Net.WinForms" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\**\*" LogicalName="Mapbox.Net.Web.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
