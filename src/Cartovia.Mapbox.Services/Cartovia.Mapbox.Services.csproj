<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(CartoviaLibraryTargets)</TargetFrameworks>
    <AssemblyName>Cartovia.Mapbox.Services</AssemblyName>
    <RootNamespace>Cartovia.Mapbox.Services</RootNamespace>
    <PackageId>Cartovia.Mapbox.Services</PackageId>
    <Description>Optional Mapbox extension of Cartovia: strongly-typed .NET client for the Mapbox web services (access token required): Geocoding v6, Search Box, Directions, Matrix, Isochrone, Optimization, Map Matching, Tilequery and Static Images. Results are exposed as Cartovia GeoJSON types so they can be put on the map directly. HttpClient + System.Text.Json only.</Description>
    <PackageTags>$(PackageTags);geocoding;directions;routing;isochrone;static-maps;tilequery;rest</PackageTags>
  </PropertyGroup>

  <!-- .NET 6 ships System.Text.Json 6; use the 8.x package for a consistent API surface. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cartovia.Core\Cartovia.Core.csproj" />
  </ItemGroup>

</Project>
