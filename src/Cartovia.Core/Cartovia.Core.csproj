<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(CartoviaLibraryTargets)</TargetFrameworks>
    <AssemblyName>Cartovia.Core</AssemblyName>
    <RootNamespace>Cartovia</RootNamespace>
    <PackageId>Cartovia.Core</PackageId>
    <Description>UI-agnostic core of Cartovia, vector maps for .NET desktop apps: strongly-typed MapLibre GL JS / Mapbox GL JS API (camera, sources, every style layer and property, expressions, markers, popups, controls, plugins, events) driven through a JSON bridge. Use Cartovia.Wpf or Cartovia.WinForms for a ready-to-use control.</Description>
  </PropertyGroup>

  <!-- .NET 6 ships System.Text.Json 6; use the 8.x package for a consistent API surface. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cartovia.WebView2" />
    <InternalsVisibleTo Include="Cartovia.Wpf" />
    <InternalsVisibleTo Include="Cartovia.WinForms" />
    <InternalsVisibleTo Include="Cartovia.Avalonia" />
    <InternalsVisibleTo Include="Cartovia.WinUI" />
    <InternalsVisibleTo Include="Cartovia.Maui" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\**\*" LogicalName="Cartovia.Web.%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
