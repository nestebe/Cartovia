<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(CartoviaWindowsTargets)</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <AssemblyName>Cartovia.Wpf</AssemblyName>
    <RootNamespace>Cartovia.Wpf</RootNamespace>
    <PackageId>Cartovia.Wpf</PackageId>
    <Description>Cartovia WPF map control: vector maps with MapLibre GL JS (no account needed) or Mapbox GL JS, hosted in WebView2: every layer type and style property, expressions, markers, popups, controls, plugins (draw, geocoder, directions, turf), events and MVVM-friendly bindable camera.</Description>
    <PackageTags>$(PackageTags);wpf;xaml;mvvm</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cartovia.WebView2\Cartovia.WebView2.csproj" />
  </ItemGroup>

</Project>
