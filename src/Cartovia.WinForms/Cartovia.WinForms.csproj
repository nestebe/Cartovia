<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(CartoviaWindowsTargets)</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Cartovia.WinForms</AssemblyName>
    <RootNamespace>Cartovia.WinForms</RootNamespace>
    <PackageId>Cartovia.WinForms</PackageId>
    <Description>Cartovia Windows Forms map control: vector maps with MapLibre GL JS (no account needed) or Mapbox GL JS, hosted in WebView2: every layer type and style property, expressions, markers, popups, controls, plugins (draw, geocoder, directions, turf) and events.</Description>
    <PackageTags>$(PackageTags);winforms;windows-forms</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <!-- Removes the WebView2 WPF reference (warning MSB3277) in consumer Windows Forms apps. -->
  <ItemGroup>
    <None Include="..\..\build\Cartovia.RemoveWebView2Wpf.targets" Pack="true" PackagePath="buildTransitive\Cartovia.WinForms.targets" Visible="false" />
    <None Include="..\..\build\Cartovia.RemoveWebView2Wpf.targets" Pack="true" PackagePath="build\Cartovia.WinForms.targets" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cartovia.WebView2\Cartovia.WebView2.csproj" />
  </ItemGroup>

</Project>
